// GitHub Codespaces setup: a Linux machine in the cloud with Node and Docker.
// Docker is needed for `npm run test:db`, which starts a throwaway Supabase.
// Keys come from your Codespaces secrets (docs/SUPABASE_SETUP.md), not files.
{
  "name": "tamil-learning-app",
  // A plain Debian Linux base, plus Node 24 and Docker added as "features".
  // (Not a ready-made Node image: there's no typescript-node image tagged 24.)
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // The default 2-core / 8 GB machine is enough (bigger ones use up the free
  // monthly Codespaces hours faster).
  // ffmpeg converts audio for the voice bake-off (spec 003).
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg && npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "App", "onAutoForward": "notify" },
    "54321": { "label": "Local test Supabase (API)", "onAutoForward": "silent" },
    "54322": { "label": "Local test Supabase (database)", "onAutoForward": "silent" }
  },
  "secrets": {
    "NEXT_PUBLIC_SUPABASE_URL": {
      "description": "Supabase → Project Settings → Data API → Project URL",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/SUPABASE_SETUP.md"
    },
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": {
      "description": "Supabase → Project Settings → API Keys → Publishable key",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/SUPABASE_SETUP.md"
    },
    "ELEVEN_LABS_API_KEY": {
      "description": "Voice bake-off (optional): ElevenLabs → Developers → API Keys",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/BAKEOFF_SETUP.md"
    },
    "AZURE_SPEECH_KEY": {
      "description": "Voice bake-off (optional): Azure Speech resource → Keys and Endpoint → KEY 1",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/BAKEOFF_SETUP.md"
    },
    "AZURE_SPEECH_REGION": {
      "description": "Voice bake-off (optional): the Speech resource's region code, e.g. eastus",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/BAKEOFF_SETUP.md"
    },
    "GOOGLE_SERVICE_ACCOUNT_JSON": {
      "description": "Voice bake-off (optional): the whole service-account key file (.json), pasted in",
      "documentationUrl": "https://github.com/nisha-tirumalai/tamil-learning-app/blob/main/docs/BAKEOFF_SETUP.md"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer", "anthropic.claude-code"]
    }
  }
}
