# Teacher's lesson material (lessons/), its overrides, and the generated
# data/ are committed with the teacher's approval (2026-11-04).

# Dependencies and build output
node_modules/
.next/
out/

# Secrets (API keys stay server-side) - must ALWAYS stay ignored
.env
.env.*
!.env.example
*.pem
*.key

# Generated by Next.js
next-env.d.ts
*.tsbuildinfo

# Private files: voice recordings for the bake-off, reference pictures, gold set.
# Put anything personal in private/ and it will never be uploaded.
private/

# Local Supabase CLI working files (created by npm run test:db)
supabase/.temp/
supabase/.branches/
