# The app needs these two settings. In Codespaces they come from your
# Codespaces secrets (docs/SUPABASE_SETUP.md, Part F), so you don't need a file.
# Only if you run the app somewhere else: copy this to .env.local (gitignored).

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
