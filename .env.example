# Copy this file to .env.local and fill in the values from your Supabase project
# (docs/SUPABASE_SETUP.md, step 6). .env.local is gitignored: never commit it.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings → API Keys → Publishable key (starts with sb_publishable_).
# Safe in the browser: row-level security decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
